# ParkBnB Environment Configuration Template
# Copy this file to .env.local and populate with your project credentials

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (India Payment Gateway)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps & Geolocation
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Communications & Notifications
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@parkbnb.in

# Background Tasks & Automation
CRON_SECRET=
