# ParkBnB Environment Configuration Template
# Copy this file to .env.local and populate with your project credentials

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database, Auth & Storage)
# Standard Supabase & @supabase/server variables
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (India Payment Gateway)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps & Geolocation
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Communications & Notifications
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@parkbnb.in

# Background Tasks & Automation
CRON_SECRET=

# Initial Bootstrap Credentials
ADMIN_INITIAL_EMAIL=admin@parkbnb.in
ADMIN_INITIAL_PASSWORD=Admin@2026!
